# Supabase Configuration
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Database URL (PostgreSQL)
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Azure OpenAI (primary LLM — used by CrewAI + LiteLLM)
# Get from: Azure Portal → Azure OpenAI → Keys and Endpoint
AZURE_API_KEY=your-azure-openai-api-key
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview
CREWAI_LLM_MODEL=azure/gpt-4o

# Google ADK (used by benchmark sub-agents only — NOT for main chat)
# Get GOOGLE_API_KEY from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key
GOOGLE_ADK_MODEL=gemini-2.0-flash
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# Get from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your-serpapi-key
