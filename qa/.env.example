# Frontend base URL (Playwright)
FRONTEND_URL=http://localhost:5173

# Backend base URL (API tests)
BACKEND_URL=http://localhost:8000

# Real Supabase test credentials — used for integration login in auth.setup.ts
TEST_EMAIL=testuser@ascendly.test
TEST_PASSWORD=TestPassword123!

# Real auth token for pytest integration tests (get from browser localStorage after login)
TEST_AUTH_TOKEN=

# Supabase Storage — used by upload-summary.js to publish summary.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
QA_RESULTS_BUCKET=qa-results
